  "widgets": [
    {
      "key": "birthdays",
      "label": {
        "en": "Birthdays",
        "fr": "Anniversaires",
        "de": "Geburtstage",
        "es": "Cumpleaños"
      },
      "description": {
        "en": "The next birthdays of the shared calendars.",
        "fr": "Les prochains anniversaires des calendriers partagés.",
        "de": "Die nächsten Geburtstage der geteilten Kalender.",
        "es": "Los próximos cumpleaños de los calendarios compartidos."
      },
      "icon": "gift",
      "settings": [
        {
          "key": "count",
          "type": "select",
          "default": "5",
          "label": {
            "en": "Number of birthdays",
            "fr": "Nombre d'anniversaires",
            "de": "Anzahl der Geburtstage",
            "es": "Número de cumpleaños"
          },
          "options": [
            {
              "value": "3",
