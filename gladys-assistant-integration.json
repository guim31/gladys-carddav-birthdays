            }
          ]
        },
        {
          "key": "kind",
          "type": "multi_select",
          "label": {
            "en": "Kind",
            "fr": "Type",
            "de": "Art",
            "es": "Tipo"
          },
          "options": [
            {
              "value": "birthday",
              "label": {
                "en": "Birthdays",
                "fr": "Anniversaires",
                "de": "Geburtstage",
                "es": "Cumpleaños"
              }
            },
            {
              "value": "anniversary",
              "label": {
                "en": "Wedding anniversaries",
                "fr": "Anniversaires de mariage",
                "de": "Hochzeitstage",
                "es": "Aniversarios de boda"
              }
            }
          ]
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Contact",
            "fr": "Contact",
            "de": "Kontakt",
            "es": "Contacto"
          },
          "description": {
            "en": "Exact name of the contact. Empty: anyone.",
            "fr": "Nom exact du contact. Vide : n'importe qui.",
            "de": "Genauer Name des Kontakts. Leer: alle.",
            "es": "Nombre exacto del contacto. Vacío: cualquiera."
          },
          "placeholder": {
            "en": "e.g. Marie Martin",
            "fr": "ex. Marie Martin",
            "de": "z. B. Marie Martin",
            "es": "p. ej. Marie Martin"
