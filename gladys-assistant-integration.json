{
  "manifest_version": 1,
  "type": "calendar",
  "name": "CardDAV Birthdays",
  "description": {
    "en": "Your contacts' birthdays from a CardDAV address book (Nextcloud, iCloud…) in Gladys's calendar.",
    "fr": "Les anniversaires de vos contacts CardDAV (Nextcloud, iCloud…) dans le calendrier de Gladys.",
    "de": "Die Geburtstage deiner CardDAV-Kontakte (Nextcloud, iCloud…) im Kalender von Gladys.",
    "es": "Los cumpleaños de sus contactos CardDAV (Nextcloud, iCloud…) en el calendario de Gladys."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-carddav-birthdays:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-carddav-birthdays/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Each user connects their own address book in \"My calendars\" below, and gets a Birthdays calendar. Only the name and the dates of a contact are read. These settings apply to everyone.",
        "fr": "Chaque utilisateur connecte son propre carnet d'adresses dans « Mes calendriers » ci-dessous, et obtient un calendrier Anniversaires. Seuls le nom et les dates d'un contact sont lus. Ces réglages valent pour tous.",
        "de": "Jeder Benutzer verbindet unten unter „Meine Kalender“ sein eigenes Adressbuch und erhält einen Geburtstagskalender. Nur Name und Daten eines Kontakts werden gelesen. Diese Einstellungen gelten für alle.",
        "es": "Cada usuario conecta su propia libreta de direcciones en «Mis calendarios» abajo y obtiene un calendario de cumpleaños. Solo se leen el nombre y las fechas de un contacto. Estos ajustes valen para todos."
      }
    },
    {
      "key": "sync_hours",
      "type": "select",
      "label": {
        "en": "Read the address books",
        "fr": "Lire les carnets d'adresses",
        "de": "Adressbücher lesen",
        "es": "Leer las libretas de direcciones"
      },
      "description": {
        "en": "Only what changed is downloaded. An account change is read at once.",
        "fr": "Seul ce qui a changé est téléchargé. Un changement de compte est lu tout de suite.",
        "de": "Nur Geändertes wird geladen. Eine Kontoänderung wird sofort gelesen.",
        "es": "Solo se descarga lo que ha cambiado. Un cambio de cuenta se lee al momento."
      },
      "default": "6",
      "options": [
        {
          "value": "1",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures",
            "de": "Stündlich",
            "es": "Cada hora"
          }
        },
        {
          "value": "6",
          "label": {
            "en": "Every 6 hours",
            "fr": "Toutes les 6 heures",
            "de": "Alle 6 Stunden",
            "es": "Cada 6 horas"
          }
        },
        {
          "value": "24",
          "label": {
            "en": "Once a day",
            "fr": "Une fois par jour",
            "de": "Einmal am Tag",
            "es": "Una vez al día"
          }
        }
      ]
    },
    {
      "key": "notify_hour",
      "type": "select",
      "label": {
        "en": "Time of the scene reminders",
        "fr": "Heure des rappels de scène",
        "de": "Uhrzeit der Szenen-Erinnerungen",
        "es": "Hora de los recordatorios de escena"
      },
      "description": {
        "en": "When the \"Birthday reminder\" trigger fires each day.",
        "fr": "Quand le déclencheur « Rappel d'anniversaire » se déclenche chaque jour.",
        "de": "Wann der Auslöser „Geburtstagserinnerung“ jeden Tag auslöst.",
        "es": "Cuándo se activa cada día el disparador «Recordatorio de cumpleaños»."
      },
      "default": "8",
      "options": [
        {
          "value": "7",
          "label": {
            "en": "07:00",
            "fr": "07:00",
            "de": "07:00",
            "es": "07:00"
          }
        },
        {
          "value": "8",
          "label": {
            "en": "08:00",
            "fr": "08:00",
            "de": "08:00",
            "es": "08:00"
          }
        },
        {
          "value": "9",
          "label": {
            "en": "09:00",
            "fr": "09:00",
            "de": "09:00",
            "es": "09:00"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10:00",
            "fr": "10:00",
            "de": "10:00",
            "es": "10:00"
          }
        },
        {
          "value": "12",
          "label": {
            "en": "12:00",
            "fr": "12:00",
            "de": "12:00",
            "es": "12:00"
          }
        },
        {
          "value": "18",
          "label": {
            "en": "18:00",
            "fr": "18:00",
            "de": "18:00",
            "es": "18:00"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the scene texts",
        "fr": "Langue des textes des scènes",
        "de": "Sprache der Szenentexte",
        "es": "Idioma de los textos de las escenas"
      },
      "description": {
        "en": "Sentences and dates handed to scenes. Calendars follow the language of their owner.",
        "fr": "Phrases et dates transmises aux scènes. Les calendriers suivent la langue de leur propriétaire.",
        "de": "An Szenen übergebene Sätze und Daten. Kalender folgen der Sprache ihres Besitzers.",
        "es": "Frases y fechas que se pasan a las escenas. Los calendarios siguen el idioma de su propietario."
      },
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "account_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your address book",
        "fr": "Votre carnet d'adresses",
        "de": "Dein Adressbuch",
        "es": "Su libreta de direcciones"
      },
      "description": {
        "en": "The CardDAV server of your contacts: Nextcloud (https://cloud.example.com/remote.php/dav), iCloud (https://contacts.icloud.com), Radicale, Baïkal… Use an app password when the service offers one. Then share the Birthdays calendar below to see it on the dashboard and use it in scenes.",
        "fr": "Le serveur CardDAV de vos contacts : Nextcloud (https://cloud.example.com/remote.php/dav), iCloud (https://contacts.icloud.com), Radicale, Baïkal… Utilisez un mot de passe d'application quand le service en propose. Partagez ensuite le calendrier Anniversaires ci-dessous pour le voir sur le tableau de bord et l'utiliser dans les scènes.",
        "de": "Der CardDAV-Server deiner Kontakte: Nextcloud (https://cloud.example.com/remote.php/dav), iCloud (https://contacts.icloud.com), Radicale, Baïkal… Nutze ein App-Passwort, wenn der Dienst eines anbietet. Teile dann unten den Geburtstagskalender, um ihn auf dem Dashboard zu sehen und in Szenen zu nutzen.",
        "es": "El servidor CardDAV de sus contactos: Nextcloud (https://cloud.example.com/remote.php/dav), iCloud (https://contacts.icloud.com), Radicale, Baïkal… Use una contraseña de aplicación cuando el servicio la ofrezca. Después comparta abajo el calendario de cumpleaños para verlo en el panel y usarlo en escenas."
      }
    },
    {
      "key": "server_url",
      "type": "string",
      "required": true,
      "label": {
        "en": "CardDAV server address",
        "fr": "Adresse du serveur CardDAV",
        "de": "CardDAV-Serveradresse",
        "es": "Dirección del servidor CardDAV"
      },
      "description": {
        "en": "The server, or the address of one address book.",
        "fr": "Le serveur, ou l'adresse d'un carnet précis.",
        "de": "Der Server oder die Adresse eines Adressbuchs.",
        "es": "El servidor, o la dirección de una libreta concreta."
      },
      "placeholder": {
        "en": "e.g. https://contacts.icloud.com",
        "fr": "ex. https://contacts.icloud.com",
        "de": "z. B. https://contacts.icloud.com",
        "es": "p. ej. https://contacts.icloud.com"
      }
    },
    {
      "key": "username",
      "type": "string",
      "required": true,
      "label": {
        "en": "User name",
        "fr": "Identifiant",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "placeholder": {
        "en": "e.g. marie@example.com",
        "fr": "ex. marie@example.com",
        "de": "z. B. marie@example.com",
        "es": "p. ej. marie@example.com"
      }
    },
    {
      "key": "password",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Password or app password",
        "fr": "Mot de passe ou mot de passe d'application",
        "de": "Passwort oder App-Passwort",
        "es": "Contraseña o contraseña de aplicación"
      },
      "description": {
        "en": "iCloud requires an app password (appleid.apple.com). Kept by Gladys, never logged.",
        "fr": "iCloud exige un mot de passe d'application (appleid.apple.com). Gardé par Gladys, jamais journalisé.",
        "de": "iCloud verlangt ein App-Passwort (appleid.apple.com). Von Gladys verwahrt, nie protokolliert.",
        "es": "iCloud exige una contraseña de aplicación (appleid.apple.com). Guardada por Gladys, nunca registrada."
      }
    },
    {
      "key": "address_books",
      "type": "string",
      "label": {
        "en": "Address books",
        "fr": "Carnets d'adresses",
        "de": "Adressbücher",
        "es": "Libretas de direcciones"
      },
      "description": {
        "en": "Names of the address books to read, separated by commas. Empty: all of them.",
        "fr": "Noms des carnets à lire, séparés par des virgules. Vide : tous.",
        "de": "Namen der zu lesenden Adressbücher, durch Kommas getrennt. Leer: alle.",
        "es": "Nombres de las libretas que leer, separados por comas. Vacío: todas."
      },
      "placeholder": {
        "en": "e.g. Contacts",
        "fr": "ex. Contacts",
        "de": "z. B. Kontakte",
        "es": "p. ej. Contactos"
      }
    },
    {
      "key": "anniversaries",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Also add wedding anniversaries",
        "fr": "Ajouter aussi les anniversaires de mariage",
        "de": "Auch Hochzeitstage hinzufügen",
        "es": "Añadir también los aniversarios de boda"
      },
      "description": {
        "en": "The ANNIVERSARY date of the contacts, in a second calendar.",
        "fr": "La date ANNIVERSARY des contacts, dans un second calendrier.",
        "de": "Das ANNIVERSARY-Datum der Kontakte, in einem zweiten Kalender.",
        "es": "La fecha ANNIVERSARY de los contactos, en un segundo calendario."
      }
    },
    {
      "key": "show_age",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Show the age in the event names",
        "fr": "Afficher l'âge dans le nom des événements",
        "de": "Alter im Terminnamen anzeigen",
        "es": "Mostrar la edad en el nombre de los eventos"
      },
      "description": {
        "en": "When the year of birth is known: \"Marie's birthday (34)\".",
        "fr": "Quand l'année de naissance est connue : « Anniversaire de Marie (34 ans) ».",
        "de": "Wenn das Geburtsjahr bekannt ist: „Geburtstag von Marie (34 Jahre)“.",
        "es": "Cuando se conoce el año de nacimiento: «Cumpleaños de Marie (34 años)»."
      }
    }
  ],
  "scene_triggers": [
    {
      "key": "birthday_reminder",
      "label": {
        "en": "Birthday reminder",
        "fr": "Rappel d'anniversaire",
        "de": "Geburtstagserinnerung",
        "es": "Recordatorio de cumpleaños"
      },
      "description": {
        "en": "Each day at the chosen time, for a birthday of a shared calendar.",
        "fr": "Chaque jour à l'heure choisie, pour un anniversaire d'un calendrier partagé.",
        "de": "Jeden Tag zur gewählten Uhrzeit, für einen Geburtstag eines geteilten Kalenders.",
        "es": "Cada día a la hora elegida, para un cumpleaños de un calendario compartido."
      },
      "fields": [
