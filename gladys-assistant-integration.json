  "scene_actions": [
    {
      "key": "next_birthday",
      "label": {
        "en": "Get the next birthday",
        "fr": "Connaître le prochain anniversaire",
        "de": "Nächsten Geburtstag abfragen",
        "es": "Consultar el próximo cumpleaños"
      },
      "description": {
        "en": "Who, in how many days, how old, and the birthdays of the day.",
        "fr": "Qui, dans combien de jours, quel âge, et les anniversaires du jour.",
        "de": "Wer, in wie vielen Tagen, wie alt, und die Geburtstage des Tages.",
        "es": "Quién, dentro de cuántos días, qué edad, y los cumpleaños del día."
      },
      "timeout_seconds": 10,
